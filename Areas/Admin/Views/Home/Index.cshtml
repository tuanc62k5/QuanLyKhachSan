@using DoAn.Models
@{
  Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

  var tongKhachHang = ViewBag.TongKhachHang ?? 0;
  var tongPhong = ViewBag.TongPhong ?? 0;
  var tongDatPhong = ViewBag.TongDatPhong ?? 0;
  var tongSuDungDichVu = ViewBag.TongSuDungDichVu ?? 0;
  var tongHoaDon = ViewBag.TongHoaDon ?? 0;
  decimal tongDoanhThu = ViewBag.TongDoanhThu ?? 0;

  var recentBookings = ViewBag.RecentBookings as List<tblDatPhong>;
  var recentInvoices = ViewBag.RecentInvoices as List<tblHoaDon>;
}

<main id="main" class="main">

  <div class="pagetitle">
    <h1>Thống kê</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item active">Thống kê</li>
      </ol>
    </nav>
  </div>

  <section class="section dashboard">

    <!-- TOP CARDS -->
    <div class="row mb-4">

      <!-- KHÁCH HÀNG -->
      <div class="col-lg-4 col-md-6">
        <div class="card info-card customers-card h-100 top-card">
          <div class="card-body">
            <h5 class="card-title">Khách hàng <span>| Tổng</span></h5>

            <div class="d-flex align-items-center justify-content-center top-card-content">
              <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                <i class="bi bi-people"></i>
              </div>
              <div class="ps-4">
                <h6>@tongKhachHang</h6>
                <span class="text-muted small pt-2 d-block">Khách hàng hệ thống</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PHÒNG -->
      <div class="col-lg-4 col-md-6">
        <div class="card info-card sales-card h-100 top-card">
          <div class="card-body">
            <h5 class="card-title">Đặt phòng <span>| Tổng</span></h5>

            <div class="d-flex align-items-center justify-content-center top-card-content">
              <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                <i class="bi bi-house-door"></i>
              </div>
              <div class="ps-4">
                <h6>@tongDatPhong</h6>
                <span class="text-muted small pt-2 d-block">Số lần đặt phòng</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- DOANH THU -->
      <div class="col-lg-4 col-md-12">
        <div class="card info-card revenue-card h-100 top-card">
          <div class="card-body">
            <h5 class="card-title">Doanh thu <span>| Tổng</span></h5>

            <div class="d-flex align-items-center justify-content-center top-card-content">
              <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                <i class="bi bi-cash-stack"></i>
              </div>
              <div class="ps-4">
                <h6 class="revenue-text">
                  @String.Format("{0:N0}", tongDoanhThu) đ
                </h6>
                <span class="text-muted small pt-2 d-block">Từ hóa đơn</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>


    <!-- BOTTOM -->
    <div class="row">

      <!-- THỐNG KÊ HỆ THỐNG -->
      <div class="col-lg-8">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Thống kê hàng tháng</h5>

            <div id="reportsChart"></div>

            <script>
                          document.addEventListener("DOMContentLoaded", () => {
                            new ApexCharts(document.querySelector("#reportsChart"), {
                              series: [{
                                name: 'Dữ liệu',
                                data: [@tongPhong, @tongKhachHang, @tongDatPhong, @tongSuDungDichVu, @tongHoaDon]
                              }],
                              chart: {
                                height: 420,
                                type: 'bar',
                                toolbar: { show: false }
                              },
                              colors: ['#4154f1'],
                              plotOptions: {
                                bar: {
                                  borderRadius: 8,
                                  columnWidth: '55%'
                                }
                              },
                              dataLabels: {
                                enabled: true
                              },
                              xaxis: {
                                categories: ['Phòng', 'Khách hàng', 'Đặt phòng', 'Dịch vụ sử dụng', 'Hóa đơn']
                              }
                            }).render();
                          });
            </script>

          </div>
        </div>
      </div>


      <!-- TỔNG QUAN -->
      <div class="col-lg-4">
        <div class="card">
          <div class="card-body pb-0">
            <h5 class="card-title">Tổng quan hàng tháng</h5>

            <div id="trafficChart" style="min-height: 420px;" class="echart"></div>

            <script>
                          document.addEventListener("DOMContentLoaded", () => {
                            echarts.init(document.querySelector("#trafficChart")).setOption({
                              tooltip: {
                                trigger: 'item'
                              },
                              legend: {
                                top: '5%',
                                left: 'center',
                                width: '90%',
                                itemWidth: 22,
                                itemHeight: 14,
                                itemGap: 18,

                                textStyle: {
                                  fontSize: 16,
                                  color: '#444',
                                  padding: [0, 8, 0, 4]
                                }
                              },
                              series: [{
                                name: 'Tổng',
                                type: 'pie',
                                radius: ['45%', '72%'],
                                center: ['50%', '58%'],
                                label: {
                                  show: false
                                },
                                labelLine: {
                                  show: false
                                },
                                data: [
                                  { value: @tongKhachHang, name: 'Khách hàng' },
                                  { value: @tongPhong, name: 'Phòng' },
                                  { value: @tongDatPhong, name: 'Đặt phòng' },
                                  { value: @tongSuDungDichVu, name: 'Dịch vụ sử dụng' },
                                  { value: @tongHoaDon, name: 'Hóa đơn' }
                                ]
                              }]
                            });
                          });
            </script>

          </div>
        </div>
      </div>

      <!-- RECENT DATA -->
      <div class="row mt-4">

        <!-- ĐẶT PHÒNG GẦN ĐÂY -->
        <div class="col-lg-8">
          <div class="card recent-sales overflow-auto">
            <div class="card-body">
              <h5 class="card-title">Đặt phòng gần đây</h5>

              <table class="table table-borderless datatable align-middle">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Khách hàng</th>
                    <th>Phòng</th>
                    <th>Ngày đặt</th>
                    <th>Trạng thái</th>
                  </tr>
                </thead>

                <tbody>
                  @if (recentBookings != null && recentBookings.Any())
                  {
                    foreach (var item in recentBookings)
                    {
                      <tr>
                        <td>#@item.DP_ID</td>
                        <td class="fw-semibold">
                          @item.KhachHang?.KH_TenKhach
                        </td>
                        <td>
                          @item.Phong?.P_TenPhong
                        </td>
                        <td>
                          @item.DP_NgayTao.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                          @if (item.DP_TrangThai == "Đã duyệt")
                          {
                            <span class="badge bg-success">@item.DP_TrangThai</span>
                          }
                          else if (item.DP_TrangThai == "Đã hủy")
                          {
                            <span class="badge bg-danger">@item.DP_TrangThai</span>
                          }
                          else
                          {
                            <span class="badge bg-primary">@item.DP_TrangThai</span>
                          }
                        </td>
                      </tr>
                    }
                  }
                  else
                  {
                    <tr>
                      <td colspan="5" class="text-center text-muted">
                        Chưa có dữ liệu đặt phòng
                      </td>
                    </tr>
                  }
                </tbody>
              </table>

            </div>
          </div>
        </div>


        <!-- HÓA ĐƠN GẦN ĐÂY -->
        <div class="col-lg-4">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">Hóa đơn gần đây</h5>

              <div class="activity">

                @if (recentInvoices != null && recentInvoices.Any())
                {
                  foreach (var hd in recentInvoices)
                  {
                    <div class="activity-item d-flex mb-4">

                      <div class="activite-label fw-bold">
                        @hd.HD_ID
                      </div>

                      <i class="bi bi-circle-fill activity-badge text-success align-self-start"></i>

                      <div class="activity-content ps-2">
                        <div class="fw-semibold">
                          @hd.DatPhong?.KhachHang?.KH_TenKhach
                        </div>

                        <span class="text-dark fw-bold">
                          @String.Format("{0:N0}", hd.HD_TongTien) đ
                        </span>

                        <div class="small text-muted">
                          @hd.HD_NgayLap.ToString("dd/MM/yyyy HH:mm")
                        </div>
                      </div>

                    </div>
                  }
                }
                else
                {
                  <div class="text-center text-muted py-4">
                    Chưa có dữ liệu hóa đơn
                  </div>
                }

              </div>

            </div>
          </div>
        </div>

      </div>

    </div>

  </section>

</main>