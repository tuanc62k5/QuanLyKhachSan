@using DoAn.Models
@using System.Text.Json

@{
  Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

  decimal tongDoanhThu = ViewBag.TongDoanhThu ?? 0;

  var tongDatPhong = ViewBag.TongDatPhong ?? 0;
  var khachDangO = ViewBag.KhachDangO ?? 0;
  var phongTrong = ViewBag.PhongTrong ?? 0;

  var recentBookings = ViewBag.RecentBookings as List<tblDatPhong>;
  var recentInvoices = ViewBag.RecentInvoices as List<tblHoaDon>;

  var topPhong = ViewBag.TopPhong;
  var topKhachHang = ViewBag.TopKhachHang;

}

<main id="main" class="main">

  <div class="pagetitle">
    <h1 class="fw-bold mb-4">Thống kê khách sạn</h1>
  </div>

  <section class="section dashboard">

    <div class="card shadow-sm border-0 mb-4">

      <div class="card-body p-4">

        <form method="get">

          <div class="row g-3">

            <div class="col-md-5">

              <label class="fw-bold mb-2 d-block">Từ ngày</label>
              <input type="date" name="tuNgay" class="form-control"
                     value="@(ViewBag.TuNgay != null ? ((DateTime)ViewBag.TuNgay).ToString("yyyy-MM-dd") : "")" />

            </div>

            <div class="col-md-5">

              <label class="fw-bold mb-2 d-block">Đến ngày</label>

              <input type="date" name="denNgay" class="form-control"
                     value="@(ViewBag.DenNgay != null ? ((DateTime)ViewBag.DenNgay).ToString("yyyy-MM-dd") : "")" />

            </div>

            <div class="col-md-2 d-flex align-items-end">

              <button class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Thống kê
              </button>

            </div>

          </div>

        </form>

      </div>

    </div>

    <div class="row">

      <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow-sm h-100" style="border-radius:18px">

          <div class="card-body d-flex flex-column justify-content-center text-center">

            <h4 class="fw-bold mb-2">Doanh thu</h4>

            <h2 class="text-success fw-bold mb-2">@String.Format("{0:N0}", tongDoanhThu) đ</h2>

            <small class="text-muted">Doanh thu đã thanh toán</small>

          </div>

        </div>

      </div>

      <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow-sm h-100" style="border-radius:18px">

          <div class="card-body d-flex flex-column justify-content-center text-center">

            <h4 class="fw-bold mb-2">Đặt phòng</h4>

            <h2 class="text-primary fw-bold mb-2">@tongDatPhong</h2>

            <small class="text-muted">Số đơn đặt phòng</small>

          </div>

        </div>

      </div>

      <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow-sm h-100" style="border-radius:18px">

          <div class="card-body d-flex flex-column justify-content-center text-center">

            <h4 class="fw-bold mb-2">Khách đang ở</h4>

            <h2 class="text-warning fw-bold mb-2">@khachDangO</h2>

            <small class="text-muted">Đang sử dụng phòng</small>

          </div>

        </div>

      </div>

      <div class="col-lg-3 col-md-6">

        <div class="card border-0 shadow-sm h-100" style="border-radius:18px">

          <div class="card-body d-flex flex-column justify-content-center text-center">

            <h4 class="fw-bold mb-2">Phòng trống</h4>

            <h2 class="text-info fw-bold mb-2">@phongTrong</h2>

            <small class="text-muted">Phòng khả dụng</small>

          </div>

        </div>

      </div>

    </div>

    <div class="row mt-4">

      <div class="col-lg-8">

        <div class="card border-0 shadow-sm">

          <div class="card-body">

            <h5 class="card-title">📈 Doanh thu theo @ViewBag.ChartType</h5>

            <div id="reportsChart"></div>

          </div>

        </div>

      </div>

      <div class="col-lg-4">

        <div class="card border-0 shadow-sm">

          <div class="card-body">

            <h5 class="card-title">🏨 Trạng thái phòng</h5>

            <div id="trafficChart" style="min-height:435px;" class="echart">
            </div>

          </div>

        </div>

      </div>

    </div>


    <script>

          document.addEventListener("DOMContentLoaded", () => {

            new ApexCharts(
              document.querySelector("#reportsChart"),
              {
                chart: {
                  type: 'area',
                  height: 420,
                  toolbar: {
                    show: false
                  }
                },

                colors: ['#0d6efd', '#198754', '#fd7e14'],

                dataLabels: {
                  enabled: false
                },

                stroke: {
                  curve: 'smooth',
                  width: 4
                },

                markers: {
                  size: 5
                },

                series: [
                  {
                    name: 'Tổng doanh thu',
                    data: @Html.Raw(JsonSerializer.Serialize(ViewBag.ChartTong))
                  },
                  {
                    name: 'Doanh thu phòng',
                    data: @Html.Raw(JsonSerializer.Serialize(ViewBag.ChartPhong))
                  },
                  {
                    name: 'Doanh thu dịch vụ',
                    data: @Html.Raw(JsonSerializer.Serialize(ViewBag.ChartDichVu))
                  }],

                xaxis: {categories: @Html.Raw(JsonSerializer.Serialize(ViewBag.ChartLabels))
                  },

                yaxis: {
                  labels: {
                    formatter: function (val) {
                      return val.toLocaleString('vi-VN');
                    }
                  }
                },

                tooltip: {
                  y: {
                    formatter: function (val) {
                      return val.toLocaleString('vi-VN') + ' đ';
                    }
                  }
                }
              }
            ).render();

          });

    </script>

    <script>

          document.addEventListener("DOMContentLoaded", () => {

            echarts.init(
              document.querySelector("#trafficChart")
            ).setOption({

              tooltip: {
                trigger: 'item',
                formatter: '{b}: {c} phòng ({d}%)'
              },

              legend: {
                top: 10,
                left: 'center'
              },

              series: [{

                name: 'Trạng thái',

                type: 'pie',

                radius: ['55%', '82%'],

                label: {
                  show: false
                },

                labelLine: {
                  show: false
                },

                data: [

                  {
                    value: @ViewBag.PhongTrong,
                    name: 'Phòng trống'
                  },

                  {
                    value: @ViewBag.PhongDaDat,
                    name: 'Đã đặt'
                  },

                  {
                    value: @ViewBag.KhachDangO,
                    name: 'Đang ở'
                  },

                  {
                    value: @ViewBag.DatPhongChoDuyet,
                    name: 'Chờ duyệt'
                  }

                ]
              }]
            });

          });

    </script>

    <div class="row mt-4">

      <div class="col-lg-8">

        <div class="card border-0 shadow-sm py-4">

          <div class="card-body">

            <h5 class="card-title">📋 Đặt phòng gần đây</h5>

            <table class="table table-hover align-middle">

              <thead>

                <tr>
                  <th>ID</th>
                  <th>Khách hàng</th>
                  <th>Phòng</th>
                  <th>Ngày nhận</th>
                  <th>Trạng thái</th>
                </tr>

              </thead>

              <tbody>

                @if (recentBookings != null && recentBookings.Any())
                {
                  foreach (var item in recentBookings)
                  {
                    <tr>

                      <td>
                        #@item.DP_ID
                      </td>

                      <td>
                        @item.KhachHang?.KH_TenKhach
                      </td>

                      <td>
                        @item.Phong?.P_TenPhong
                      </td>

                      <td>
                        @item.DP_NgayNhan.ToString("dd/MM/yyyy HH:mm")
                      </td>

                      <td>

                        @if (item.DP_TrangThai == "Đã duyệt")
                        {
                          <span class="badge bg-success">
                            @item.DP_TrangThai
                          </span>
                        }
                        else if (item.DP_TrangThai == "Đang ở")
                        {
                          <span class="badge bg-warning">
                            @item.DP_TrangThai
                          </span>
                        }
                        else if (item.DP_TrangThai == "Đã hủy")
                        {
                          <span class="badge bg-danger">
                            @item.DP_TrangThai
                          </span>
                        }
                        else
                        {
                          <span class="badge bg-primary">
                            @item.DP_TrangThai
                          </span>
                        }

                      </td>

                    </tr>
                  }
                }
                else
                {
                  <tr>

                    <td colspan="5" class="text-center text-muted">

                      Chưa có dữ liệu đặt phòng

                    </td>

                  </tr>
                }

              </tbody>

            </table>

          </div>

        </div>

      </div>

      <div class="col-lg-4">

        <div class="card border-0 shadow-sm py-1">

          <div class="card-body">

            <h5 class="card-title">💰 Hóa đơn gần đây</h5>

            <div class="activity">

              @if (recentInvoices != null && recentInvoices.Any())
              {
                foreach (var hd in recentInvoices)
                {
                  <div class="activity-item d-flex mb-4">

                    <div class="activite-label fw-bold">

                      #@hd.HD_ID

                    </div>

                    <i class="bi bi-circle-fill
                      activity-badge
                      text-success
                      align-self-start">
                    </i>

                    <div class="activity-content ps-3">

                      <div class="fw-semibold">

                        @hd.DatPhong?.KhachHang?.KH_TenKhach

                      </div>

                      <div class="text-success fw-bold">

                        @String.Format("{0:N0}",
                        hd.HD_TongTien) đ

                      </div>

                      <small class="text-muted">

                        @hd.HD_NgayLap.ToString("dd/MM/yyyy HH:mm")

                      </small>

                    </div>

                  </div>
                }
              }
              else
              {
                <div class="text-center text-muted py-4">

                  Chưa có dữ liệu hóa đơn

                </div>
              }

            </div>

          </div>

        </div>

      </div>

    </div>

    <div class="row mt-4">

      <div class="col-lg-6">

        <div class="card border-0 shadow-sm">

          <div class="card-body">

            <h5 class="card-title">
              🏆 Top phòng được đặt nhiều nhất
            </h5>

            <table class="table">

              <thead>

                <tr>
                  <th>Phòng</th>
                  <th>Lượt đặt</th>
                </tr>

              </thead>

              <tbody>

                @foreach (var item in ViewBag.TopPhong)
                {
                  <tr>
                    <td>@item.TenPhong</td>
                    <td>@item.SoLuot</td>
                  </tr>
                }

              </tbody>

            </table>

          </div>

        </div>

      </div>

      <div class="col-lg-6">

        <div class="card border-0 shadow-sm">

          <div class="card-body">

            <h5 class="card-title">
              🍽️ Dịch vụ sử dụng nhiều nhất
            </h5>

            <table class="table">

              <thead>

                <tr>
                  <th>Dịch vụ</th>
                  <th>Số lần sử dụng</th>
                </tr>

              </thead>

              <tbody>

                @foreach (var item in ViewBag.TopDichVu)
                {
                  <tr>
                    <td>@item.TenDichVu</td>
                    <td>@item.SoLanSuDung</td>
                  </tr>
                }

              </tbody>

            </table>

          </div>

        </div>

      </div>

    </div>

    
  </section>

</main>
