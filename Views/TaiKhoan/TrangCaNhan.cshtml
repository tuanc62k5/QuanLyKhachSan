@model DoAn.Models.tblKhachHang

<div class="container mt-5">
    <div class="row">

        <div class="col-md-4">
            <div class="card shadow-sm p-4 text-center">
                @if (!string.IsNullOrEmpty(Model.KH_HinhAnh))
                {
                    <img src="~/img/@Model.KH_HinhAnh"
                         class="rounded-circle mx-auto d-block mb-3 border border-3 border-warning"
                         style="width:140px;height:140px;object-fit:cover;" />
                }
                else
                {
                    <i class="fa fa-user-circle fa-5x text-primary mb-3"></i>
                }

                <h5>@Model.KH_TenKhach</h5>
                <p class="text-muted">@Model.KH_Email</p>

                <hr />

                <p><i class="fa fa-phone"></i> @Model.KH_DienThoai</p>

                <button class="btn btn-outline-primary w-100 mt-3" onclick="togglePassword()">
                    🔒 Đổi mật khẩu
                </button>
            </div>
        </div>

        <div class="col-md-8">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="card shadow-sm p-4">
                <h3 class="mb-4">Cập nhật thông tin</h3>

                <form asp-action="SuaThongTin" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="KH_ID" />

                    <div class="mb-3">
                        <label>Ảnh đại diện</label>
                        <input type="file" name="avatarFile" class="form-control" accept="image/*" />
                    </div>

                    <div class="mb-3">
                        <label>Tên</label>
                        <input asp-for="KH_TenKhach" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Email</label>
                        <input asp-for="KH_Email" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label>SĐT</label>
                        <input asp-for="KH_DienThoai" class="form-control" />
                    </div>

                    <button class="btn btn-primary w-100">
                        💾 Lưu thay đổi
                    </button>
                </form>
            </div>

            <div id="formPass" class="card shadow-sm p-4 mt-3" style="display:none;">
                <h5 class="mb-3">Đổi mật khẩu</h5>

                <form asp-action="DoiMatKhau" method="post">
                    <input type="hidden" asp-for="KH_ID" />

                    <div class="mb-3">
                        <label>Mật khẩu cũ</label>
                        <input type="password" name="oldPass" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Mật khẩu mới</label>
                        <input type="password" name="newPass" class="form-control" />
                    </div>

                    <button class="btn btn-success w-100">
                        🔄 Đổi mật khẩu
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

<script>
    function togglePassword() {
        var x = document.getElementById("formPass");
        x.style.display = (x.style.display === "none") ? "block" : "none";
    }
</script>